# Laptop (no sandbox needed). Copy to .env, then: php scripts/migrate.php
MODE=mock
DB_DSN=sqlite:/tmp/klimatex-dev.db
# Seeding creates one demo login per role with this password, e.g. auditor@demo.klimatex.test
DEMO_PASSWORD=choose-a-local-password

# In the cluster these come from Kubernetes secrets (see k8s/app.yaml), never from a file:
# MODE=live
# DB_DSN=pgsql:host=postgres;port=5432;dbname=klimatex
# DB_USER=klimatex
# DB_PASS=<strong-password>
# JWT_SECRET=<at least 32 random characters>
# GATEWAY_KEY      <- injected from the huawei-gateway secret
# WEBHOOK_SECRET   <- returned once by POST /api/sandbox/register-webhook
