{
    "name": "klimatex/backend",
    "description": "KlimateX API: metered household carbon, verification, credits and settlement",
    "type": "project",
    "license": "proprietary",
    "autoload": {
        "psr-4": { "App\\": "src/" },
        "files": ["src/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "migrate": "php scripts/migrate.php"
    },
    "config": {
        "platform": { "php": "8.3.0" },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-pdo": "*",
        "anthropic-ai/sdk": "^1.7",
        "bacon/bacon-qr-code": "^3.0",
        "firebase/php-jwt": "^7.0",
        "guzzlehttp/guzzle": "^8.3",
        "nikic/fast-route": "^1.3",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    }
}
